# Copy to .env (git-ignored; keep it mode 600) and fill in. Never commit .env.
# Read by tools/remote/remote.sh and tools/semantic-search/. Environment variables of the same name win.

# --- tools/remote: the build host ---------------------------------------------------------------
REMOTE_HOST=builder@build-host            # ssh target, key login (BatchMode)
REMOTE_ROOT=/srv/build/mymod              # this project's directory on the host
REMOTE_REPO_URL=https://github.com/<owner>/<repo>.git   # what the host fetches over https
REMOTE_MOD_ID=examplemod                  # jar name prefix, e.g. examplemod-1.0.0.jar
# Ranges on a shared host: choose ones nobody else uses.
REMOTE_PORT_BASE=26000                    # real-pack server; instance N uses BASE+20+N
REMOTE_DEV_PORT_MIN=26010                 # dev servers (runServer)
REMOTE_DEV_PORT_MAX=26019
REMOTE_DISPLAY_MIN=100                    # Xvfb displays for clients
REMOTE_DISPLAY_MAX=109
# REMOTE_PACK_LEVEL_TYPE=rwg              # level-type the pack's server.properties ships
# REMOTE_BUILD_TIMEOUT=3600               # seconds

# --- tools/semantic-search ----------------------------------------------------------------------
OPENROUTER_API_KEY=
# SEMSEARCH_UPSTREAM_REF=upstream-src     # local branch holding the upstream mod's source
